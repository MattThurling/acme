# Base URL of the Medifinance app the serverless functions call.
MEDIFINANCE_API_URL=http://localhost:8000
# Bearer key issued to Acme Ltd in the Medifinance admin. Ask for a *sandbox*
# key for development: it validates everything but creates nothing.
MEDIFINANCE_API_KEY=mfk_paste_your_key_here
# Set to 1 to skip Medifinance entirely and return a fake reference (used by
# the automated tests; handy when you have no key to hand).
MEDIFINANCE_MOCK=
# Public origin of this deployment, used in MCP server instructions/links.
PUBLIC_ORIGIN=https://acme-amber-beta.vercel.app
