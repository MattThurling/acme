{
  "name": "acme-ltd",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "build": "node scripts/build-ui.mjs",
    "dev": "npm run build && node --env-file-if-exists=.env scripts/dev-server.mjs",
    "test": "npm run build && npm run test:mcp && npm run test:site",
